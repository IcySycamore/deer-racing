<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- 启用 WebSocket 支持 -->
    <webSocket enabled="true" />
    <rewrite>
      <rules>
        <!-- 将全部请求（含 /socket.io/ 与 WebSocket 升级）转发给 Node.js -->
        <rule name="ProxyToNode" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:50865/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
